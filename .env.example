# ===========================================
# Application Configuration
# ===========================================
APP_NAME="The Tables ERP"
APP_ENV=local

# SECURITY: Run 'php artisan key:generate' to generate a secure APP_KEY
# Never share or commit this key
APP_KEY=

# SECURITY: Set to false in production to prevent sensitive data exposure
APP_DEBUG=false

APP_URL=http://localhost

# Frontend URL for client portal access emails
FRONTEND_URL=http://localhost:3000
# Generate once with php artisan notifications:vapid
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
TIMER_EXPIRE_ON_DISCONNECT=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/auth/google/callback

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Password hashing strength (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ===========================================
# Logging Configuration
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# Database Configuration
# ===========================================
# SECURITY: Use strong database credentials in production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=business_os
DB_USERNAME=business_os_user
DB_PASSWORD=your_secure_password_here

# ===========================================
# Session Configuration
# ===========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120

# SECURITY: Enable session encryption in production
SESSION_ENCRYPT=true

SESSION_PATH=/
SESSION_DOMAIN=null

# ===========================================
# Broadcasting & Queue Configuration
# ===========================================
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ===========================================
# Cache Configuration
# ===========================================
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ===========================================
# Redis Configuration
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# Mail Configuration
# ===========================================
MAIL_MAILER=smtp
MAIL_SCHEME=https
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# AWS Configuration (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# Sanctum API Token Configuration
# ===========================================
# SECURITY: Token expiration in minutes (1440 = 24 hours)
# Set to null for tokens that never expire (not recommended)
SANCTUM_TOKEN_EXPIRATION=1440

# Optional token prefix for security scanning
SANCTUM_TOKEN_PREFIX=

# ===========================================
# Reverb WebSocket Configuration
# ===========================================
REVERB_APP_ID=business-os
REVERB_APP_KEY=your_reverb_app_key
REVERB_APP_SECRET=your_reverb_app_secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ===========================================
# Security Headers (Recommended in production)
# ===========================================
# These can be used by middleware for additional security
# SECURITY_HEADERS_ENABLED=true

# ===========================================
# Rate Limiting Configuration
# ===========================================
# API requests per minute (use 1200 for local/E2E runs; production default is 300)
API_RATE_LIMIT=1200

# Failed authentication attempts per email/IP per minute; successful logins do not count
AUTH_RATE_LIMIT=10

# ===========================================
# Access Control Devices (fingerprint / card terminals)
# ===========================================
# Poll the terminals for new access events (ISAPI).
DEVICE_POLLING_ENABLED=true
DEVICE_POLL_INTERVAL_MINUTES=5
# How far back a poll looks for events. A small overlap absorbs clock drift.
DEVICE_POLL_LOOKBACK_MINUTES=60

# Public endpoint the terminal can push its events to.
DEVICE_WEBHOOK_ENABLED=true
DEVICE_WEBHOOK_RATE_LIMIT=120

# ISAPI client behaviour.
DEVICE_ISAPI_TIMEOUT=15
DEVICE_ISAPI_CONNECT_TIMEOUT=5
# Keep false for terminals with a self-signed certificate.
DEVICE_ISAPI_VERIFY_TLS=false
# How the employee is verified on the terminal: fpOrCard, fp, card, faceOrFpOrCardOrPw
DEVICE_USER_VERIFY_MODE=fpOrCard
DEVICE_DOOR_RIGHT=1
DEVICE_BELONG_GROUP=1
DEVICE_VALIDITY_YEARS=10

# Prefix used when the ERP employee number is written to the terminal.
DEVICE_EMPLOYEE_NO_PREFIX=
DEVICE_EMPLOYEE_NO_FALLBACK_USER_ID=true

# ISAPI "minor" codes that represent a rejected authentication attempt.
DEVICE_DENIED_MINOR_CODES=
# ISAPI "statusValue" codes that represent a granted authentication attempt.
DEVICE_AUTHORIZED_STATUS_VALUES=

# Default credentials used when a terminal is registered without explicit ones.
HIKVISION_DEFAULT_USERNAME=admin
HIKVISION_DEFAULT_PASSWORD=
HIKVISION_DEFAULT_PORT=80
