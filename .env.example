APP_NAME="Elmo Tech ERP V2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elmo_erp_v2
DB_USERNAME=elmo
DB_PASSWORD=

# Set a unique local-only value in .env before running docker compose.
POSTGRES_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

LOG_CHANNEL=stack
MAIL_MAILER=log
# First-party SPA; match the local frontend origin exactly, including ports.
SPA_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
# HTTPS deployed domains require Secure cookies, an explicit origin list and review.
# Never configure CORS wildcard for cookie-authenticated requests.
